<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ masks this to the launcher's shape. The foreground PNGs are
     generated by tool/generate_icons.swift; monochrome reuses them because the
     glyphs are already single-colour, which gives Android 13 themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
